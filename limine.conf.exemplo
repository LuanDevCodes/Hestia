timeout: 5
default_entry: 2
remember_last_entry: yes

# CachyOS Limine theme
# Author: diegons490
term_palette: 000000;f5c2e7;94e2d5;cdd6f4
term_palette_bright: 585b70;f38ba8;a6e3a1;f9e2af;89b4fa;f5c2e7;94e2d5;cdd6f4
term_background: 1e1e2e
term_foreground: cdd6f4
term_background_bright: 1e1e2e
term_foreground_bright: cdd6f4
interface_branding: 
wallpaper: boot():/limine-splash.png

comment: machine-id=0123456789abcdef0123456789abcdef
/+CachyOS
  //linux-cachyos
  ### This kernel entry is auto-generated by limine-entry-tool
  comment: Kernel version: 7.0.2-6-cachyos
  comment: kernel-id=linux-cachyos
  protocol: linux
  module_path: boot():
  path: boot():
  cmdline: quiet nowatchdog splash rw rootflags=subvol=/@ root=UUID=12345678-1234-1234-1234-123456789abc

  //linux-cachyos-lts
  ### This kernel entry is auto-generated by limine-entry-tool
  comment: Kernel version: 6.15.02-3-cachyos-lts
  comment: kernel-id=linux-cachyos-lts
  protocol: linux
  module_path: boot():
  path: boot():
  cmdline: quiet nowatchdog splash rw rootflags=subvol=/@ root=UUID=12345678-1234-1234-1234-123456789abc

  //Snapshots
  ### Auto-generated by limine-snapper-sync
  comment: 90 snapshots
  ///162 | 2026-09-26 19:19:59
  comment: qt6-webengine qt6-websockets